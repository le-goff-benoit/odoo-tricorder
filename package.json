{
  "name": "odoo-tricorder",
  "version": "0.6.0-rc.9",
  "desktopName": "odoo-tricorder.desktop",
  "description": "Conception de workflows, dialogue terminal et suivi du travail",
  "author": {
    "name": "Benoît Le Goff",
    "email": "le-goff-benoit@users.noreply.github.com"
  },
  "homepage": "https://github.com/le-goff-benoit/odoo-tricorder",
  "repository": {
    "type": "git",
    "url": "https://github.com/le-goff-benoit/odoo-tricorder.git"
  },
  "license": "MIT",
  "main": "electron/entry.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "python3 -m unittest discover -s tests -v && node --test tests/*.test.cjs",
    "test:ui": "npm run build && playwright test",
    "test:packaged": "node scripts/test-packaged.mjs",
    "checksum": "node scripts/checksum.mjs",
    "pack": "npm run build && electron-builder --linux dir --publish never",
    "dist": "npm run build && electron-builder --linux deb --publish never"
  },
  "build": {
    "appId": "dev.odoo.tricorder",
    "productName": "Tricorder",
    "directories": {
      "output": "build-artifacts"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "**/*.json",
          "!**/__pycache__/**"
        ]
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.svg",
      "executableName": "odoo-tricorder",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "odoo-tricorder",
          "Keywords": "Odoo;Terminal;Claude;Codex;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2",
        "python3",
        "git",
        "bubblewrap"
      ]
    },
    "fileAssociations": [
      {
        "ext": "tricorder-workflow",
        "name": "Workflow Tricorder",
        "description": "Modèle de workflow Tricorder portable",
        "mimeType": "application/x-tricorder-workflow",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.16",
    "marked": "18.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
